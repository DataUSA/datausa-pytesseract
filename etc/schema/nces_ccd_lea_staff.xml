<Schema name="datausa" default_locale="en">
  <Cube name="nces_ccd_lea_staff">
    <Annotation name="source_name">National Center for Education Statistics (NCES)</Annotation>
    <Annotation name="source_link">https://nces.ed.gov/ccd/</Annotation>
    <Annotation name="source_description">The Common Core of Data (CCD) is the Department of Education's primary database on public elementary and secondary education in the United States. It is collected annually from state education agencies by the National Center for Education Statistics (NCES).</Annotation>
    <Annotation name="dataset_name">CCD Local Education Agency Staff</Annotation>
    <Annotation name="dataset_link">https://nces.ed.gov/ccd/files.asp</Annotation>
    <Annotation name="topic">Education</Annotation>
    <Annotation name="subtopic">Staff</Annotation>
    <Table name="nces_ccd_lea_staff"/>

    <!-- Only school district rows are loaded: expose only the School District level -->
    <DimensionUsage foreign_key="geoid" name="Geography" source="Geography">
      <HierarchyUsage source="School District" name="School District">
        <LevelUsage source="School District" name="School District"/>
      </HierarchyUsage>
    </DimensionUsage>

    <Dimension name="Year" foreign_key="year" type="time">
      <Annotation name="dim_type">TIME</Annotation>
      <Hierarchy name="Year" primary_key="year">
        <Level key_column="year" name="Year" key_type="u16"/>
      </Hierarchy>
    </Dimension>

    <Dimension foreign_key="staff_id" name="Staff">
      <Hierarchy name="Staff">
        <InlineTable name="staff_id_table" format="tuples">
          <Row>("staff_group_id", "staff_group", "staff_id", "staff")</Row>
          <Row>(1, "Teachers", 1, "Pre-Kindergarten Teachers")</Row>
          <Row>(1, "Teachers", 2, "Kindergarten Teachers")</Row>
          <Row>(1, "Teachers", 3, "Elementary Teachers")</Row>
          <Row>(1, "Teachers", 4, "Secondary Teachers")</Row>
          <Row>(1, "Teachers", 5, "Ungraded Teachers")</Row>
          <Row>(2, "Guidance Counselors", 6, "Elementary School Counselors")</Row>
          <Row>(2, "Guidance Counselors", 7, "Secondary School Counselors")</Row>
          <Row>(2, "Guidance Counselors", 8, "School Counselors")</Row>
          <Row>(3, "LEA Staff", 9, "LEA Administrators")</Row>
          <Row>(3, "LEA Staff", 10, "LEA Administrative Support Staff")</Row>
          <Row>(3, "LEA Staff", 11, "Instructional Coordinators and Supervisors")</Row>
          <Row>(4, "School Staff", 12, "School Administrators")</Row>
          <Row>(4, "School Staff", 13, "School Administrative Support Staff")</Row>
          <Row>(4, "School Staff", 14, "Librarians and Media Specialists")</Row>
          <Row>(4, "School Staff", 15, "Library and Media Support Staff")</Row>
          <Row>(4, "School Staff", 16, "Paraprofessionals and Instructional Aides")</Row>
          <Row>(4, "School Staff", 17, "School Psychologists")</Row>
          <Row>(4, "School Staff", 18, "Student Support Services Staff (Excluding Psychology)")</Row>
          <Row>(5, "Other Staff", 19, "All Other Support Staff")</Row>
        </InlineTable>
        <Level key_column="staff_group_id" name="Staff Group" name_column="staff_group" key_type="u8"/>
        <Level key_column="staff_id" name="Staff" name_column="staff" key_type="u8"/>
      </Hierarchy>
    </Dimension>

    <Measure aggregator="sum" key_column="fte" name="Staff FTE" visible="true">
      <Annotation name="aggregation_method">SUM</Annotation>
      <Annotation name="units_of_measurement">Count</Annotation>
      <Annotation name="ui_default_drilldown">Staff Group</Annotation>
    </Measure>
  </Cube>
</Schema>
