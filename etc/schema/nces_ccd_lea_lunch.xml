<Schema name="datausa" default_locale="en">
  <Cube name="nces_ccd_lea_lunch">
    <Annotation name="source_name">National Center for Education Statistics (NCES)</Annotation>
    <Annotation name="source_link">https://nces.ed.gov/ccd/</Annotation>
    <Annotation name="source_description">The Common Core of Data (CCD) is the Department of Education's primary database on public elementary and secondary education in the United States. It is collected annually from state education agencies by the National Center for Education Statistics (NCES).</Annotation>
    <Annotation name="dataset_name">CCD School Lunch Program Eligibility</Annotation>
    <Annotation name="dataset_link">https://nces.ed.gov/ccd/files.asp</Annotation>
    <Annotation name="topic">Education</Annotation>
    <Annotation name="subtopic">Enrollment</Annotation>
    <Table name="nces_ccd_lea_lunch"/>

    <!-- Only school district rows are loaded: expose only the School District level -->
    <DimensionUsage foreign_key="geoid" name="Geography" source="Geography">
      <HierarchyUsage source="School District" name="School District">
        <LevelUsage source="School District" name="School District"/>
      </HierarchyUsage>
    </DimensionUsage>

    <Dimension name="Year" foreign_key="year" type="time">
      <Annotation name="dim_type">TIME</Annotation>
      <Hierarchy name="Year" primary_key="year">
        <Level key_column="year" name="Year" key_type="u16"/>
      </Hierarchy>
    </Dimension>

    <Dimension foreign_key="lunch_program_id" name="Lunch Program">
      <Hierarchy name="Lunch Program">
        <InlineTable name="lunch_program_id_table" format="tuples">
          <Row>("lunch_program_id", "lunch_program")</Row>
          <Row>(1, "Free Lunch Qualified")</Row>
          <Row>(2, "Reduced-Price Lunch Qualified")</Row>
          <Row>(3, "Direct Certification")</Row>
        </InlineTable>
        <Level key_column="lunch_program_id" name="Lunch Program" name_column="lunch_program" key_type="u8"/>
      </Hierarchy>
    </Dimension>

    <Measure aggregator="sum" key_column="students" name="Students" visible="true">
      <Annotation name="aggregation_method">SUM</Annotation>
      <Annotation name="units_of_measurement">People</Annotation>
      <Annotation name="ui_default_drilldown">Lunch Program</Annotation>
    </Measure>
    <Measure aggregator="sum" key_column="schools" name="Schools Reporting" visible="true">
      <Annotation name="aggregation_method">SUM</Annotation>
      <Annotation name="units_of_measurement">Count</Annotation>
      <Annotation name="details">Schools that reported a value for the lunch program. Use with the Lunch Program drilldown.</Annotation>
    </Measure>
  </Cube>
</Schema>
